# Встроенный PostgreSQL (порт 5433, поднимается автоматически командой
# `pnpm setup` / `pnpm dev:all` / start.bat). Бинарники ставятся при pnpm install.
DATABASE_URL="postgresql://journal:journal@localhost:5433/students_journal?schema=public"

# Путь к старой SQLite-БД для одноразовой миграции данных.
# Если файл существует, при первом запуске данные переносятся автоматически.
# (используется скриптом: pnpm db:migrate-from-sqlite)
SQLITE_DATABASE_URL="file:./old/dev.db"

# NextAuth (при создании .env из примера секреты генерируются автоматически)
NEXTAUTH_SECRET="generate-your-own-with-openssl-rand-base64-32"
AUTH_SECRET="generate-your-own-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
